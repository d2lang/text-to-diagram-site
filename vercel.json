{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes --package=yarn@1.22.22 -- yarn install --frozen-lockfile",
  "buildCommand": "npx --yes --package=yarn@1.22.22 -- yarn build",
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.text-to-diagram.com"
        }
      ],
      "destination": "https://text-to-diagram.com/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/js/script.js",
      "destination": "https://plausible.io/js/script.js"
    },
    {
      "source": "/api/event",
      "destination": "https://plausible.io/api/event"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "interest-cohort=()"
        }
      ]
    },
    {
      "source": "/((?!js/script[.]js$|api/event$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=300"
        }
      ]
    },
    {
      "source": "/_next/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    },
    {
      "source": "/:directory(fonts|images|favicon)/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=86400"
        }
      ]
    }
  ]
}
